# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Local database (rebuilt from data/processed on startup) ---
*.db
*.sqlite3

# --- Ingestion raw cache (regenerated; only data/processed is committed) ---
backend/data/raw/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/

# --- OS / editor / local tooling ---
.DS_Store
.idea/
.vscode/
*.swp
.claude/

# TypeScript build cache
*.tsbuildinfo

# Pulse backend configuration — copy to .env and fill in.
# NEVER commit a real .env file (see .gitignore).

# --- Claude "Explain this chart" feature (Phase 3) ---
# Get a key at https://console.anthropic.com/. The app runs fine without it
# (the explain endpoint falls back to a templated, non-AI summary).
ANTHROPIC_API_KEY=
# Model id used for explanations. Defaults to the fast/cheap Haiku tier.
PULSE_ANTHROPIC_MODEL=claude-haiku-4-5

# --- Database ---
# SQLite for local dev; set a postgresql:// URL in production (Postgres-ready).
PULSE_DATABASE_URL=sqlite:///./pulse.db

# --- API hardening ---
# Comma-separated list of allowed browser origins (the frontend URL).
PULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Default per-client rate limit applied to API routes.
PULSE_RATE_LIMIT=60/minute
